# .gcloudignore — prevents gcloud from uploading heavy caches and unused dirs
.gcloudignore
.git
.gitignore

# Virtual environments
.venv/
venv/
ENV/
env/

# Python cache
**/__pycache__/
*.py[cod]
*$py.class

# IDE / config
.pytest_cache/
.vscode/
.idea/

# Environment files
.env
.env*.local

# Heavy Hugging Face local cache (rebuilt in cloud)
.hf_cache/

# Unused experiment folders
KG+RL/
PC+RL/
HKG+PC+RL/criminal/
HKG+PC+RL/family/

