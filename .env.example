# Legal QA API — Environment Variables
# Copy this file to .env and fill in your values.

# ── Required ────────────────────────────────────────────────────────────────
# OpenAI API key (used by the GPT-4o generation step)
OPENAI_API_KEY=your-openai-api-key-here

# ── Optional overrides ─────────────────────────────────────────────────────
# LLM backend: openai | groq | ollama | hflocal  (default: openai)
# LLM_BACKEND=openai

# OpenAI model override (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Groq API key (only needed if LLM_BACKEND=groq)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Ollama settings (only needed if LLM_BACKEND=ollama)
# OLLAMA_MODEL=llama3
# OLLAMA_URL=http://localhost:11434/api/generate

# HuggingFace local model (only needed if LLM_BACKEND=hflocal)
# HF_MODEL=microsoft/phi-2

# ── Data directory override ─────────────────────────────────────────────────
# Path to the experiment directory containing edges.csv, *.pt checkpoints, etc.
# Default: HKG+PC+RL/Employment_Labour/actionable/
# LEGAL_QA_DATA_DIR=C:\path\to\your\data\directory
